# Copy this file to `.env` (same directory) and fill in the values.
# `python -m app.main` loads the repository-root `.env` at startup and
# merges it UNDER the real environment: variables already set in the
# environment always win (ADR-022). `.env` is gitignored — never commit it.

# Backend selection for the gateway (see app/config.py).
#   deepseek_web — real DeepSeek Web backend (requires DEEPSEEK_AUTH_TOKEN)
#   fake         — deterministic offline backend for development/tests
# Defaults to deepseek_web when unset.
GATEWAY_BACKEND=deepseek_web

# DeepSeek Web auth token.
# How to obtain (from the upstream README):
#   1. Log in to https://chat.deepseek.com in a browser.
#   2. Open DevTools console and run:
#        JSON.parse(localStorage.getItem("userToken")).value
# Treat this value as a secret. Never commit it, never log it.
DEEPSEEK_AUTH_TOKEN=

# Optional: file path (JSON) holding cookies captured for Cloudflare
# clearance, in the shape {"cookies": {"cf_clearance": "...", ...}}.
# Only needed if DeepSeek serves Cloudflare challenges for your account/IP.
DSQG_COOKIES_FILE=

# Gateway API key for Qwen Code -> gateway auth on /v1/* (M2).
# Secure by default: when unset, /v1/* refuses to serve with 503.
# Treat this value as a secret. Never commit it, never log it.
DEEPSEEK_GATEWAY_API_KEY=

# Development opt-in: allow /v1/* WITHOUT a key when no key is configured.
# Do not enable this unless the gateway is strictly local/throwaway.
GATEWAY_ALLOW_NO_AUTH=0

# Model alias advertised by GET /v1/models and required in request "model".
GATEWAY_MODEL_ID=deepseek-web

# Bind address for `python -m app.main`.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

# M5: opt-in diagnostic request capture (app/diagnostics.py).
# When set to a directory, every authenticated /v1/chat/completions request
# is appended (sanitized: the Authorization value is NEVER written) to
# <dir>/requests.jsonl so the exact wire format of a real Qwen Code install
# can be fixtured. Request bodies ARE written — point this at a private
# location. Unset/empty = capture disabled (the default).
GATEWAY_DIAGNOSTICS_DIR=

# M9 (ADR-036): reliability knobs.
# Max transport RETRIES per request for retryable pre-byte failures
# (rate limit, network, upstream 5xx, truncated pre-byte turns).
# Total attempts = 1 + GATEWAY_MAX_RETRIES. Non-retryable failures always
# make exactly one attempt. Default: 2.
GATEWAY_MAX_RETRIES=2

# Linear backoff base in seconds: retry n sleeps base * n (no jitter).
# Default: 0.5 (retries sleep 0.5 s, then 1.0 s).
GATEWAY_RETRY_BACKOFF_SECONDS=0.5

# Upstream request timeout in seconds (annotated vendor patch,
# vendor/deepseek4free/dsk/api.py). With streaming this is an INACTIVITY
# bound (a silent socket aborts after this long; healthy long streams
# survive); on control-plane calls it is a total timeout. Must be > 0.
# Default: 60.
DSQG_UPSTREAM_TIMEOUT_SECONDS=60
