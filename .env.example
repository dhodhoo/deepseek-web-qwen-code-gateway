# Backend selection for the gateway (see app/config.py).
#   deepseek_web — real DeepSeek Web backend (requires DEEPSEEK_AUTH_TOKEN)
#   fake         — deterministic offline backend for development/tests
# Defaults to deepseek_web when unset.
GATEWAY_BACKEND=deepseek_web

# DeepSeek Web auth token.
# How to obtain (from the upstream README):
#   1. Log in to https://chat.deepseek.com in a browser.
#   2. Open DevTools console and run:
#        JSON.parse(localStorage.getItem("userToken")).value
# Treat this value as a secret. Never commit it, never log it.
DEEPSEEK_AUTH_TOKEN=

# Optional: file path (JSON) holding cookies captured for Cloudflare
# clearance, in the shape {"cookies": {"cf_clearance": "...", ...}}.
# Only needed if DeepSeek serves Cloudflare challenges for your account/IP.
DSQG_COOKIES_FILE=

# Later milestones (gateway API key for Qwen Code -> gateway auth):
# DEEPSEEK_GATEWAY_API_KEY=
